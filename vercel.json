{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/invite",
      "destination": "/api/public?what=invite"
    },
    {
      "source": "/api/status",
      "destination": "/api/public?what=status"
    },
    {
      "source": "/api/captcha",
      "destination": "/api/public?what=captcha"
    },
    {
      "source": "/api/vlipy",
      "destination": "/api/public?what=vlipy"
    },
    {
      "source": "/s/:name",
      "destination": "/api/site?name=:name&path=index.html"
    },
    {
      "source": "/s/:name/:path*",
      "destination": "/api/site?name=:name&path=:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!www\\.)[a-z0-9-]+)\\.vlipa\\.dev"
        }
      ],
      "destination": "/api/site?name=:site&path=:path*"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/invite/:slug",
      "destination": "/invite.html"
    },
    {
      "source": "/setup",
      "destination": "/setup.html"
    },
    {
      "source": "/vlipy",
      "destination": "/vlipy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=()"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
