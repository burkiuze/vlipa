# Put these into Vercel → Settings → Environment Variables. Do not fill this
# file in and commit it; .env is already in .gitignore.

# --- Storage (required: without it nothing survives a restart) ---
# Supabase → Project Settings → API
#   Project URL  -> SUPABASE_URL
#   Secret key (sb_secret_... , formerly service_role) -> SUPABASE_SECRET_KEY
#
# The publishable (anon) key does NOT work here and must not be used: it is the
# key meant for browsers, and this store holds password hashes and live session
# tokens. Never add the secret key with a NEXT_PUBLIC_ prefix — that prefix
# means "ship this to the browser".
#
# Create the tables once: Supabase → SQL Editor → run supabase.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs sessions and captcha tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Vlipa ---
# The OpenRouter key. Stays on the server; no browser ever sees it.
OPENROUTER_API_KEY=

# The model Vlipa runs on. Empty means minimax/minimax-m3:free.
# To check a model id: /api/status?models=minimax
# Both modes use the same model; what changes is how it is asked.
CHAT_MODEL_FAST=minimax/minimax-m3:free

# A different model for Think mode, if you want one. Empty uses the one above.
CHAT_MODEL_THINKING=

# Optional fallbacks, tried in order when the model above refuses. Leave empty:
# anything listed here becomes callable, and a model you are not sure is free
# ends up on your bill.
CHAT_MODEL_FALLBACKS=

# The address OpenRouter sees as the referer.
PUBLIC_URL=https://vlipa.dev

# --- Signing in with Google (optional) ---
# Google Cloud → Google Auth Platform → Clients → Create client
#   Application type: Web application
#   Authorized JavaScript origins:  https://vlipa.dev
#   Authorized redirect URIs:       https://vlipa.dev/api/auth/google-callback
# Both values belong only in Vercel's environment variables. With either one
# missing, the Google button never appears.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if the callback is not PUBLIC_URL + /api/auth/google-callback.
GOOGLE_REDIRECT_URI=

# --- Mail (optional) ---
# Sends one message: "somebody gave you a task". Written against Resend's HTTP
# API, because a serverless function cannot hold an SMTP connection open.
# Verify vlipa.dev with the provider first, or mail from no-reply@ is dropped.
RESEND_API_KEY=
MAIL_FROM=Vlipa <no-reply@vlipa.dev>

# --- Qwen, which runs on Groq rather than OpenRouter (optional) ---
# Without the key, Vlipa Studio simply does not offer Qwen. GROQ_MODEL exists
# because provider catalogues move: if Groq renames the model, only this
# changes. /setup shows which id is being asked for.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen-3.8-27b

# --- Publishing from Vlipa Studio ---
# A published project is served at <name>.vlipa.dev for seven days. For that to
# resolve, add the wildcard domain *.vlipa.dev to this Vercel project and point
# a wildcard CNAME at Vercel. Without it, sites still work at /s/<name>/.

# --- Models offered in the picker (optional overrides) ---
# The interface can only ask for these; nothing else is callable, so no request
# can put an unasked-for model on the bill.
CHAT_MODEL_GLM=z-ai/glm-5.2:free
CHAT_MODEL_GEMMA=google/gemma-4-31b-it:free
CHAT_MODEL_NEMOTRON=nvidia/nemotron-3.5-lightning:free

# --- An alternative to Supabase, not an addition ---
# Only read when SUPABASE_URL and SUPABASE_SECRET_KEY are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
