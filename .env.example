# Vercel'de Settings -> Environment Variables altına gir. Bu dosyayı doldurup
# commit etme; .env zaten .gitignore'da.

# OpenRouter anahtarı. Sunucuda kalır, tarayıcıya asla gitmez.
OPENROUTER_API_KEY=

# Vlipa'nın modeli. Boş bırakırsan minimax/minimax-m3:free kullanılır.
# Model kimliğini doğrulamak için: /api/status?models=minimax
# İki mod da aynı modelle çalışır; değişen, modele nasıl sorulduğudur.
CHAT_MODEL_FAST=minimax/minimax-m3:free

# Düşün modu için ayrı bir model kullanmak istersen. Boşsa yukarıdaki kullanılır.
CHAT_MODEL_THINKING=

# İsteğe bağlı yedekler: yukarıdaki model cevap vermezse sırayla denenir.
# Boş bırak. Buraya yazdığın her model çağrılabilir hale gelir; ücretsiz
# olduğundan emin olmadığın bir modeli yazma, faturası sana çıkar.
CHAT_MODEL_FALLBACKS=

# OpenRouter'ın istekte gördüğü adres.
PUBLIC_URL=https://vlipa.dev

# --- Google ile giriş (isteğe bağlı) ---
# Google Cloud -> Google Auth Platform -> Clients -> Create client
#   Application type: Web application
#   Authorized JavaScript origins:  https://vlipa.dev
#   Authorized redirect URIs:       https://vlipa.dev/api/auth/google-callback
# Buradaki iki değeri sadece Vercel'in Environment Variables ekranına yaz.
# İkisi de boşsa giriş sayfasında Google düğmesi hiç görünmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yukarıdaki adresi değiştirdiysen buraya birebir aynısını yaz. Boşsa
# PUBLIC_URL + /api/auth/google-callback kullanılır.
GOOGLE_REDIRECT_URI=

# --- Kalıcı depolama (şiddetle önerilir) ---
# Bunlar olmadan hesaplar, şirketler ve görevler sunucu yenilenince silinir.
# Vercel -> Storage -> Upstash Redis (KV) açtığında kendiliğinden eklenir.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Supabase (verilerin kalıcı olması için) ---
# Supabase -> Project Settings -> API
#   Project URL          -> SUPABASE_URL
#   Secret key (sb_secret_... ya da eski adıyla service_role)  -> SUPABASE_SECRET_KEY
#
# Publishable (anon) anahtar BURADA İŞE YARAMAZ ve yazılmamalı: bu anahtar
# tarayıcıya verilmek içindir, sunucu tarafı depolama gizli anahtar ister.
# Gizli anahtarı asla NEXT_PUBLIC_ önekiyle ekleme; o önek "tarayıcıya gitsin"
# demektir. Anahtarı sadece Vercel'in Environment Variables ekranına yaz.
#
# Tabloları bir kez kur: Supabase -> SQL Editor -> supabase.sql dosyasını çalıştır.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
