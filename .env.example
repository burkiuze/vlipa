# Copy these into the Vercel project (Settings -> Environment Variables).

# OpenRouter key. The studio only ever calls free models, but the key is what
# authorises those calls. It stays on the server and is never sent to a browser.
OPENROUTER_API_KEY=

# Signs sessions and captcha tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Storage for accounts, sites and teams. Create a Vercel KV / Upstash Redis
# database and these two arrive on their own. Without them the studio falls
# back to memory, which forgets everything between requests.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Where published shops live: elma.vlipa.dev
PUBLISH_DOMAIN=vlipa.dev

# Used as the referer OpenRouter sees.
PUBLIC_URL=https://vlipa.dev
